{% doc %}
  @prompt
    make me place where i can add my products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-shelf-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-shelf-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-product-shelf-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-product-shelf-{{ ai_gen_id }}__intro {
    margin: 8px 0 0;
    color: {{ block.settings.muted_text_color }};
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-product-shelf-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-product-shelf-{{ ai_gen_id }}__card {
    min-width: 0;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-product-shelf-{{ ai_gen_id }}__image-wrap,
  .ai-product-shelf-{{ ai_gen_id }}__placeholder {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background: {{ block.settings.image_background }};
  }

  .ai-product-shelf-{{ ai_gen_id }}__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .ai-product-shelf-{{ ai_gen_id }}__card:hover img,
  .ai-product-shelf-{{ ai_gen_id }}__card:focus-visible img {
    transform: scale(1.03);
  }

  .ai-product-shelf-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-shelf-{{ ai_gen_id }}__placeholder svg {
    width: 58%;
    height: 58%;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-product-shelf-{{ ai_gen_id }}__details {
    padding-top: 12px;
  }

  .ai-product-shelf-{{ ai_gen_id }}__product-title {
    margin: 0 0 6px;
    font-size: 16px;
    line-height: 1.35;
  }

  .ai-product-shelf-{{ ai_gen_id }}__price {
    color: {{ block.settings.muted_text_color }};
    font-size: 14px;
  }

  .ai-product-shelf-{{ ai_gen_id }}__empty {
    padding: 32px 20px;
    border: 1px dashed {{ block.settings.empty_border_color }};
    border-radius: {{ block.settings.image_radius }}px;
    color: {{ block.settings.muted_text_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-product-shelf-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 0;
    }

    .ai-product-shelf-{{ ai_gen_id }}__header {
      display: block;
      margin-bottom: 18px;
    }

    .ai-product-shelf-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<div class="ai-product-shelf-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-product-shelf-{{ ai_gen_id }}__header">
      <div>
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-shelf-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="ai-product-shelf-{{ ai_gen_id }}__intro">{{ block.settings.description | escape }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.products != blank %}
    <div class="ai-product-shelf-{{ ai_gen_id }}__grid">
      {% for product in block.settings.products %}
        <a class="ai-product-shelf-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
          {% if product.featured_image %}
            <div class="ai-product-shelf-{{ ai_gen_id }}__image-wrap">
              <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            </div>
          {% else %}
            <div class="ai-product-shelf-{{ ai_gen_id }}__placeholder">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-product-shelf-{{ ai_gen_id }}__details">
            <h3 class="ai-product-shelf-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3>
            <div class="ai-product-shelf-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-shelf-{{ ai_gen_id }}__empty">Select products in the block settings to display them here.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product shelf",
  "settings": [
    { "type": "header", "content": "Products" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Browse our latest picks." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" } ], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 28, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "section_padding", "label": "Desktop spacing", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile spacing", "min": 0, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#555555" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#F4F4F4" },
    { "type": "color", "id": "empty_border_color", "label": "Empty state border", "default": "#777777" }
  ],
  "presets": [ { "name": "Product shelf" } ],
  "tag": null,
  "class": "product-shelf-block"
}
{% endschema %}