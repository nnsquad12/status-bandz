{% assign is_verified = false %}
{% if product.tags contains 'verified-tier' %}{% assign is_verified = true %}{% endif %}
<div class="wrap">
  <div class="product-page">
    <div class="product-media" id="gallery-{{ section.id }}">
      {% if product.media.size > 0 %}
        <div class="gallery-main">
          {% for media in product.media %}
            <img
              class="gallery-img{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              src="{{ media.preview_image | image_url: width: 1200 }}"
              alt="{{ media.preview_image.alt | default: product.title | escape }}"
              width="1200" height="1200"
              {% unless forloop.first %}loading="lazy"{% endunless %}>
          {% endfor %}
          {% if product.media.size > 1 %}
            <button type="button" class="gallery-nav prev" aria-label="Previous image">&#8249;</button>
            <button type="button" class="gallery-nav next" aria-label="Next image">&#8250;</button>
          {% endif %}
        </div>
        {% if product.media.size > 1 %}
          <div class="gallery-thumbs">
            {% for media in product.media %}
              <button type="button" class="gallery-thumb{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center">
          <div class="band" style="max-width:80%"><span class="plate">{{ product.title | truncate: 12, '' }}</span></div>
        </div>
      {% endif %}
    </div>
    <div class="product-info">
      <h1 class="display">{{ product.title }}</h1>
      <div class="price">{{ product.price | money }}</div>
      {% if is_verified and section.settings.exclusive_note != blank %}
        <div class="exclusive-note">{{ section.settings.exclusive_note }}</div>
      {% endif %}
      {% if is_verified %}
        <div class="verify-note">
          <strong>Verification required</strong>
          <p>Your order is a reservation. This band ships only after your status is verified. Once verified, your serial is added to the public registry — permanently yours, impossible to fake.</p>
        </div>
      {% endif %}
      <div class="desc rte">{{ product.description }}</div>
      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          <label for="variant-select">Option</label>
          <select id="variant-select" name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }} {% unless variant.available %}— Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}
        {% if product.available %}
          <button type="submit" class="btn full">{% if is_verified %}Reserve — verify to receive{% else %}Add to cart{% endif %}</button>
        {% else %}
          <button type="button" class="btn full" disabled>Sold out</button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('gallery-{{ section.id }}');
    if (!root) return;
    var imgs = root.querySelectorAll('.gallery-img');
    var thumbs = root.querySelectorAll('.gallery-thumb');
    if (imgs.length < 2) return;
    var current = 0;
    function show(i) {
      current = (i + imgs.length) % imgs.length;
      imgs.forEach(function (img, n) { img.classList.toggle('active', n === current); });
      thumbs.forEach(function (t, n) { t.classList.toggle('active', n === current); });
    }
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { show(parseInt(t.dataset.index, 10)); });
    });
    root.querySelector('.gallery-nav.prev').addEventListener('click', function () { show(current - 1); });
    root.querySelector('.gallery-nav.next').addEventListener('click', function () { show(current + 1); });
  })();
</script>
{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "exclusive_note",
      "label": "Exclusivity note (verified-tier products)",
      "default": "Exclusive — 1 of 25 in the world"
    }
  ]
}
{% endschema %}
