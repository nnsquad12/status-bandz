<section class="strip">
  <div class="wrap">
    <h2 class="display">{{ section.settings.title }}</h2>
    <div class="strip-cols">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "How it works" }
  ],
  "blocks": [
    {
      "type": "col",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your status" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Single. Taken. Millionaire. Wear the one that's true." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "col", "settings": { "heading": "Pick your status", "body": "Single. Taken. Millionaire. Wear the one that's true." } },
        { "type": "col", "settings": { "heading": "Limited drops", "body": "Every run is numbered and capped. When a drop sells out, that's it." } },
        { "type": "col", "settings": { "heading": "Verified tiers", "body": "Millionaire bands ship only after verification. Every serial is listed in the public registry — so nobody can fake it." } }
      ]
    }
  ]
}
{% endschema %}
