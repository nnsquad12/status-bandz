<div class="wrap">
  <div class="pad-section" style="min-height:60vh">
    <p class="kicker"><span>Next drop</span> — Loading</p>
    <h1 class="display">The list gets in first</h1>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display:flex;max-width:480px;margin-top:40px">
        <input type="email" name="contact[email]" placeholder="Email" required aria-label="Email" style="flex:1;border:1px solid #000;border-right:0;padding:13px 16px;font-family:inherit;font-size:11px;letter-spacing:.08em;border-radius:0">
        <button type="submit" class="btn">Get on the list</button>
      </div>
    {% endform %}
  </div>
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
