<section class="grid-section">
  <div class="wrap">
    <div class="grid-head">
      <h2 class="display">{{ section.settings.title }}</h2>
      <span class="small">{{ section.settings.note }}</span>
    </div>
    <div class="product-grid">
      {% assign col = collections[section.settings.collection] %}
      {% if col != blank and col.products.size > 0 %}
        {% for product in col.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="card">
            <div class="thumb"><span class="small">Add products to your collection</span></div>
            <div class="meta">
              <div class="title">Band {{ i }}</div>
              <div class="price">$0</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Drop grid",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "The drop" },
    { "type": "text", "id": "note", "label": "Side note", "default": "Limited run — no restocks" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Drop grid" }]
}
{% endschema %}
