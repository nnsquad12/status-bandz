{% assign is_verified = false %}
{% if product.tags contains 'verified-tier' %}{% assign is_verified = true %}{% endif %}
<a class="card {% if is_verified %}tier-verified{% endif %}" href="{{ product.url }}">
  <div class="thumb">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">
    {% else %}
      <div class="band" style="max-width:80%"><span class="plate">{{ product.title | truncate: 12, '' }}</span></div>
    {% endif %}
  </div>
  <div class="meta">
    <div class="title">{{ product.title }}</div>
    <div class="price">{{ product.price | money }}</div>
    {% if product.available == false %}
      <div class="flag soldout">Sold out</div>
    {% elsif is_verified %}
      <div class="flag verified">Verification required</div>
    {% endif %}
  </div>
</a>
